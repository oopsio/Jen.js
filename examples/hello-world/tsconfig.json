{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "outDir": "dist", // output folder
    "rootDir": ".", // root of your source files
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "allowJs": true,
    "declaration": true,
    "declarationDir": "dist/types", // emit types into a separate folder
    "paths": {
      "@src/*": ["lib/*"]
    }
  }
}
