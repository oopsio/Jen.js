{
  "name": "jen-js-blog-example",
  "version": "1.0.0",
  "description": "Modern blog example with Jen.js featuring Markdown posts and dynamic routes",
  "type": "module",
  "scripts": {
    "dev": "npx tsx server.ts dev",
    "start": "npx tsx server.ts start",
    "build": "npx tsx build.ts",
    "typecheck": "tsc -p ../../tsconfig.json --noEmit",
    "clean": "rmdir /s /q dist .esbuild 2>nul || exit 0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^11.1.1",
    "preact": "^10.28.3",
    "preact-render-to-string": "^6.5.13",
    "sirv": "^3.0.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "esbuild": "^0.27.3",
    "esbuild-register": "^3.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
