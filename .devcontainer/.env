# Jen.js Development Container Environment Variables
# This file is loaded during container initialization

# Node environment
NODE_ENV=development

# pnpm configuration
PNPM_HOME=/home/node/.pnpm
PNPM_STORE_DIR=/home/node/.pnpm-store

# Server configuration (from jen.config.ts)
SERVER_PORT=5173
SERVER_HOSTNAME=0.0.0.0

# Database URLs (optional - configure as needed)
# DATABASE_URL=sqlite://./data.db
# DATABASE_URL=mysql://user:password@localhost:3306/database
# DATABASE_URL=postgresql://user:password@localhost:5432/database
# DATABASE_URL=mongodb://localhost:27017/database

# Feature flags
ENABLE_SSR=true
ENABLE_LIVE_RELOAD=true

# Turbo settings
TURBO_CACHE_DIR=.turbo
TURBO_TELEMETRY_DISABLED=1

# Build settings
VITE_NODE_LOADER=esmock
