# Optional: Dev Container specific variables
# These override system variables when using VS Code Dev Containers

# Ensure proper TypeScript support
TYPESCRIPT_SKIP_PROJECT_CHECK=true

# Disable telemetry to speed up builds
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1
ASTRO_TELEMETRY_DISABLED=1

# Performance tuning
NODE_MAX_OLD_SPACE_SIZE=4096
