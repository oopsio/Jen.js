---
---

<header class="header">
  <div class="container">
    <div class="header-content">
      <div class="logo">
        <a href="/">
          <span class="logo-text">Jen.js</span>
        </a>
      </div>
      <nav class="nav">
        <a href="#features" class="nav-link">Features</a>
        <a href="#quickstart" class="nav-link">Quick Start</a>
        <a href="/docs" class="nav-link">Docs</a>
        <a href="https://github.com/oopsio/jen.js" class="nav-link" target="_blank">GitHub</a>
        <a href="https://github.com/oopsio/jen.js/discussions" class="nav-link" target="_blank">Discussions</a>
        <button class="theme-toggle" aria-label="Toggle theme" onclick="window.toggleTheme()" id="theme-btn">
          <span class="theme-icon" id="theme-icon"></span>
        </button>
      </nav>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
    z-index: 100;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 64px;
  }

  .logo {
    flex-shrink: 0;
  }

  .logo-text {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.5px;
  }

  .nav {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-link {
    font-size: 0.95rem;
    color: var(--text-secondary);
    position: relative;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--text-primary);
    transition: width 0.3s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .theme-toggle:hover {
    transform: scale(1.1);
  }

  .theme-icon {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  @media (max-width: 768px) {
    .header-content {
      height: 56px;
    }

    .logo-text {
      font-size: 1.25rem;
    }

    .nav {
      gap: 1rem;
    }

    .nav-link {
      font-size: 0.85rem;
    }
  }
</style>
