{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "outDir": "dist", // output folder
    "rootDir": ".", // root of your source files
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "allowJs": true,
    "declaration": true,
    "inlineSourceMap": true,
    "declarationDir": "dist/types", // emit types into a separate folder
    "paths": {
      "@src/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "server.ts",
    "build.ts",
    "jen.config.ts",
    "site/**/*.ts",
    "site/**/*.tsx"
  ],
  "exclude": [
    "dist" // prevent TS from seeing output as input
  ]
}
