{
  "name": "jen.js",
  "private": true,
  "packageManager": "bun@1.3.10",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "start": "node server.ts start",
    "build": "turbo run build",
    "bundle": "turbo run bundle",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck",
    "test": "vitest",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "setup": "bash scripts/setup.sh || powershell -File scripts/setup.ps1",
    "setup:unix": "bash scripts/setup.sh",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "dev:unix": "bash scripts/dev.sh",
    "dev:windows": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "build:unix": "bash scripts/build.sh",
    "build:windows": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "prepare": "husky",
    "test:coverage": "npx vitest run --coverage",
    "commit": "cross-env NODE_ENV=production node scripts/commit.js",
    "compile": "concurrently \"bunx tsc\" \"copyfiles -u 1 src/**/*.json src/**/*.wasm dist/\""
  },
  "dependencies": {
    "@jenjs/flowgen": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/glob": "^9.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@vercel/ncc": "^0.38.4",
    "@vue/compiler-sfc": "^3.4.0",
    "commander": "^14.0.3",
    "core-js": "3",
    "esbuild": "^0.27.3",
    "glob": "^13.0.3",
    "graphql": "^16.13.1",
    "html-minifier-terser": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "mysql2": "^3.17.1",
    "pg": "^8.18.0",
    "picocolors": "^1.1.1",
    "preact": "^10.28.3",
    "preact-render-to-string": "^6.5.13",
    "redis": "^5.11.0",
    "sass": "^1.97.3",
    "sirv": "^3.0.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "svelte": "^5.51.1",
    "table": "^6.9.0",
    "tsx": "^4.21.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@commitlint/cz-commitlint": "^20.4.1",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260313.1",
    "@vitest/ui": "^4.0.18",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lerna": "^9.0.4",
    "prettier": "^3.8.1",
    "turbo": "^2.8.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.55.0",
    "vitepress": "2.0.0-alpha.16",
    "vitest": "^4.0.18"
  },
  "workspaces": [
    "packages/*",
    "example/*",
    "site/**",
    "jenpack/**",
    "bench/**",
    "preactsc/**",
    "docs/**",
    "my-app/**"
  ]
}