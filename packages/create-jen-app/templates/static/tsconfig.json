{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",
    "jsxImportSource": "preact",

    "strict": true,
    "skipLibCheck": true,

    "baseUrl": ".",
    "paths": {
      "@src/*": ["lib/*"]
    },

    "types": ["node"],

    "outDir": "dist",
    "rootDir": ".",

    "allowJs": false,
    "resolveJsonModule": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "site/**/*.ts",
    "site/**/*.tsx",
    "server.ts",
    "build.ts",
    "jen.config.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "paths": {
      "jen": ["./src/*"],
      "@/*": ["./src/*"]
    }
}
