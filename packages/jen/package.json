{
  "name": "we-jenjs",
  "type": "module",
  "license": "MIT",
  "version": "1.1.1",
  "description": "The framework for the web",
  "bugs": "https://github.com/oopsio/Jen.js/issues",
  "homepage": "https://jen.js.org",
  "files": [
    "dist/src/**"
  ],
  "bin": {
    "jen": "dist/src/bin/jen.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "import": "./dist/src/client/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@swc/core": "^1.15.21",
    "@swc/html": "^1.15.18",
    "esbuild": "^0.28.1",
    "fs-extra": "^11.3.4",
    "mime": "^4.1.0",
    "preact": "^10.29.0",
    "preact-render-to-string": "^6.6.6",
    "sharp": "^0.35.4",
    "vite": "^8.0.1"
  },
  "devDependencies": {
    "@storybook/addon-links": "^10.3.5",
    "@storybook/preact": "^10.3.5",
    "@storybook/preact-vite": "^10.3.5",
    "@types/bun": "^1.3.11",
    "@types/deno": "^2.5.0",
    "@types/node": "^25.5.0",
    "storybook": "^10.3.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "eslint-plugin-storybook": "10.3.5",
    "@storybook/addon-docs": "^10.3.5"
  }
}
